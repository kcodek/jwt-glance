# ==============================================================================
# JWT Glance Test Fixtures — Semantic Tier & Ambient Aesthetics Showcase
# Open this file in VS Code to see live ambient badges, Codicons & theme effects!
# Note: Fixtures use fixed Unix timestamps for durable, reproducible local evaluation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Claim Ambient Display (Latest Feature · Up to 3 Claims)
# Default configuration: glanceClaims: ["roles", "name", "email", "sub"], maxGlanceClaims: 3
# Shows roles, full name, and email in a single ambient badge before the expiration timer.
# ------------------------------------------------------------------------------
ACTIVE_MULTI_CLAIM_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c3JfODgzOTIwMSIsIm5hbWUiOiJBbGljZSBTbWl0aCIsImVtYWlsIjoiYWxpY2VAZXhhbXBsZS5jb20iLCJyb2xlcyI6WyJhZG1pbiIsImRldmVsb3BlciJdLCJleHAiOjIwNTEyMjI0MDB9.mock_sig

# ------------------------------------------------------------------------------
# 2. Enterprise & Cloud Identity Providers (Roles & Group Mappings)
# JWT Glance automatically extracts and surfaces roles from major identity providers
# in hover cards, badges, and the interactive Action Palette ("Copy Roles").
# ------------------------------------------------------------------------------

# Keycloak OIDC Token: Extracts nested realm_access.roles & preferred_username
KEYCLOAK_OIDC_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImtjLWtleS0yMDI2In0..mock_sig

# AWS Cognito User Pool Token: Extracts cognito:groups, cognito:username & email
AWS_COGNITO_USER_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImNvZ25pdG8tdXNlYXN0MS1rZXkifQ..mock_sig

# Microsoft Entra ID / Azure AD Token: Extracts App Roles array & UPN
AZURE_ENTRA_SERVICE_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..mock_sig

# ------------------------------------------------------------------------------
# 3. Semantic Health Tiers & Visual States
# In top CodeLens mode (default), VS Code renders text in muted gray and conveys
# status via Codicons, overview ruler markers, and expired text dimming.
# If position is set to "left" or "both", inline badges use theme colors.
# ------------------------------------------------------------------------------

# ACTIVE: Pass Icon ($(pass-filled)) · Overview Ruler Mark (Green)
# Fixed future expiration (2035-01-01).
ACTIVE_SESSION_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZUBleGFtcGxlLmNvbSIsIm5hbWUiOiJBbGljZSBTbWl0aCIsInJvbGVzIjpbImFkbWluIiwiZGV2ZWxvcGVyIl0sImV4cCI6MjA1MTIyMjQwMH0.mock-sig

# EXPIRED: Error Icon ($(error)) · Dead Credential Dimmed to 55% · Overview Ruler Mark (Red)
# Fixed past expiration (2011-03-22).
EXPIRED_LEGACY_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsZWdhY3ktYXV0aC1zZXJ2aWNlIiwiZXhwIjoxMzAwODE5MzgwfQ.mock-sig

# NO_EXPIRATION: Key Icon ($(key)) · Overview Ruler Mark (Cyan) · No Expiry Timer
# Permanent machine-to-machine key without an exp claim.
PERMANENT_MACHINE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJtZXRyaWNzLWNvbGxlY3Rvci1zZXJ2aWNlIiwiaWF0IjoxNTE2MjM5MDIyfQ.mock_sig

# UNSECURED: Shield Alert Icon ($(shield) $(alert)) · Overview Ruler Mark (Red) · Warning Badge
# Token generated with alg:none without cryptographic signature.
UNSECURED_DEV_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJsb2NhbC1kZXYtcm9vdCIsInJvbGVzIjpbInN1cGVydXNlciJdfQ.

# MISSING_SIGNATURE: Warning Icon ($(warning)) · 2-Segment Draft Token
# Header and payload present, signature segment omitted entirely.
SIGNATURE_STRIPPED_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkcmFmdC11c2VyLXBheWxvYWQiLCJleHAiOjIwNTEyMjI0MDB9

# NOT_YET_ACTIVE / INDETERMINATE: Question Icon ($(question)) · Overview Ruler Mark (Muted)
# Token scheduled for the future with nbf (2035-01-01).
FUTURE_SCHEDULED_TOKEN=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJzY2hlZHVsZWQtYmF0Y2gtam9iIiwibmJmIjoyMDUxMjIyNDAwfQ.mock_sig

# ------------------------------------------------------------------------------
# 4. Safe Diagnostic Export & Privacy
# Generated by the "Export Redacted Diagnostic Token" Action Palette command.
# Safe for sharing in bug reports—replaces custom claims with [REDACTED].
# ------------------------------------------------------------------------------
REDACTED_DIAGNOSTIC_SAMPLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJbUkVEQUNURURdIiwiaWF0IjoxNTE2MjM5MDIyfQ.REDACTED_SIGNATURE